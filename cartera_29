<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard Cartera 29 — Región de La Araucanía</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root{
    --bg:#f5f7fa; --card:#ffffff; --line:#e3e8ef; --txt:#1e293b; --muted:#64748b;
    --blue:#2563eb; --green:#16a34a; --amber:#f59e0b; --red:#dc2626;
    --slate:#94a3b8; --violet:#7c3aed; --teal:#0d9488;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--txt)}
  header{background:linear-gradient(135deg,#1e3a8a,#2563eb);color:#fff;padding:18px 26px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
  header h1{margin:0;font-size:20px;font-weight:600;letter-spacing:.2px}
  header .sub{font-size:12px;opacity:.85;margin-top:2px}
  .badge{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;white-space:nowrap}
  .badge.ok{background:rgba(22,163,74,.9);border-color:transparent}
  .badge.warn{background:rgba(245,158,11,.95);border-color:transparent}
  .badge.err{background:rgba(220,38,38,.9);border-color:transparent}
  .wrap{padding:18px 22px 40px;max-width:1600px;margin:0 auto}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:16px;box-shadow:0 1px 2px rgba(16,24,40,.04)}
  .panel h3{margin:0 0 10px;font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted)}

  .controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;align-items:end}
  .fld{display:flex;flex-direction:column;gap:4px}
  .fld label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
  .fld select,.fld input{padding:7px 9px;border:1px solid var(--line);border-radius:8px;font-size:13px;background:#fff;color:var(--txt);outline:none}
  .fld select:focus,.fld input:focus{border-color:var(--blue)}
  button{padding:8px 14px;border:none;border-radius:8px;background:var(--blue);color:#fff;font-size:13px;font-weight:600;cursor:pointer}
  button:hover{background:#1d4ed8}
  button.ghost{background:#fff;color:var(--blue);border:1px solid var(--blue)}
  button.ghost:hover{background:#eff6ff}

  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}
  .kpi{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--blue);border-radius:10px;padding:12px 14px}
  .kpi .v{font-size:24px;font-weight:700;line-height:1.1}
  .kpi .l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:4px}
  .kpi.g{border-left-color:var(--green)} .kpi.a{border-left-color:var(--amber)}
  .kpi.r{border-left-color:var(--red)} .kpi.s{border-left-color:var(--slate)}
  .kpi.v2{border-left-color:var(--violet)} .kpi.t{border-left-color:var(--teal)}

  .grid{display:grid;gap:16px}
  .g3{grid-template-columns:repeat(3,1fr)}
  .g2{grid-template-columns:repeat(2,1fr)}
  @media(max-width:1100px){.g3,.g2{grid-template-columns:1fr}}
  .chartbox{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;box-shadow:0 1px 2px rgba(16,24,40,.04)}
  .chartbox h4{margin:0 0 10px;font-size:13px;font-weight:600;color:#334155}
  .cvs{position:relative;height:280px}
  .cvs.tall{height:340px}

  table{width:100%;border-collapse:collapse;font-size:12.5px}
  th{background:#f1f5f9;text-align:left;padding:8px 9px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);position:sticky;top:0}
  td{padding:7px 9px;border-top:1px solid var(--line);vertical-align:top}
  tr:hover td{background:#f8fafc}
  .num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  .pill{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
  .p-at{background:#dcfce7;color:#15803d}
  .p-ev{background:#dbeafe;color:#1d4ed8}
  .p-es{background:#fef3c7;color:#b45309}
  .p-de{background:#fee2e2;color:#b91c1c}
  .p-re{background:#e2e8f0;color:#475569}
  .p-ot{background:#f1f5f9;color:#64748b}
  .d-ok{color:#15803d;font-weight:600}
  .d-mid{color:#b45309;font-weight:600}
  .d-bad{color:#b91c1c;font-weight:700}
  .scroll{max-height:520px;overflow:auto;border:1px solid var(--line);border-radius:10px}
  .note{font-size:12px;color:var(--muted);margin-top:6px}
  .err{background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px}
  .err.hidden{display:none}
</style>
</head>
<body>

<header>
  <div>
    <h1>Dashboard Cartera 29 — Iniciativas de Inversión</h1>
    <div class="sub">Región de La Araucanía · Hoja: <b>cartera_29</b></div>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <span id="srcBadge" class="badge warn">Cargando…</span>
    <span id="updBadge" class="badge">—</span>
  </div>
</header>

<div class="wrap">

  <div id="errBox" class="err hidden"></div>

  <!-- FILTROS -->
  <div class="panel">
    <h3>Filtros</h3>
    <div class="controls">
      <div class="fld"><label>Estado</label><select id="fEstado"><option value="">Todos</option></select></div>
      <div class="fld"><label>Evaluador</label><select id="fEval"><option value="">Todos</option></select></div>
      <div class="fld"><label>Tipología</label><select id="fTipo"><option value="">Todas</option></select></div>
      <div class="fld"><label>Comuna / Formulador</label><select id="fComuna"><option value="">Todas</option></select></div>
      <div class="fld"><label>Buscar (BIP o nombre)</label><input id="fText" placeholder="texto…"></div>
      <div class="fld"><button class="ghost" id="btnReset">Limpiar filtros</button></div>
    </div>
  </div>

  <!-- KPIs -->
  <div class="kpis" id="kpis"></div>

  <!-- FILA 1 -->
  <div class="grid g3" style="margin-bottom:16px">
    <div class="chartbox"><h4>Distribución por estado</h4><div class="cvs"><canvas id="chEstado"></canvas></div></div>
    <div class="chartbox"><h4>Top 10 comunas por monto (MM$)</h4><div class="cvs"><canvas id="chComunas"></canvas></div></div>
    <div class="chartbox"><h4>Monto por tipología (MM$)</h4><div class="cvs"><canvas id="chTipologia"></canvas></div></div>
  </div>

  <!-- FILA 2 -->
  <div class="grid g3" style="margin-bottom:16px">
    <div class="chartbox"><h4>Carga por evaluador y estado</h4><div class="cvs"><canvas id="chEval"></canvas></div></div>
    <div class="chartbox"><h4>Monto por formulador (MM$)</h4><div class="cvs"><canvas id="chForm"></canvas></div></div>
    <div class="chartbox"><h4>Distribución por rango de monto</h4><div class="cvs"><canvas id="chRango"></canvas></div></div>
  </div>

  <!-- FILA 3 -->
  <div class="grid g2" style="margin-bottom:16px">
    <div class="chartbox"><h4>Documentos (Ord./Memo/AT) por mes</h4><div class="cvs"><canvas id="chDocsMes"></canvas></div></div>
    <div class="chartbox"><h4>Top 10 iniciativas con más días sin movimiento</h4><div class="cvs tall"><canvas id="chDias"></canvas></div></div>
  </div>

  <!-- TABLA SEMÁFORO -->
  <div class="chartbox">
    <h4>🚦 Tabla de seguimiento — ordenada por días sin movimiento</h4>
    <div class="scroll">
      <table id="tabla">
        <thead>
          <tr>
            <th>BIP</th><th>Iniciativa</th><th>Comuna</th><th>Formulador</th>
            <th>Tipología</th><th>Estado</th><th>Evaluador</th>
            <th class="num">Monto MM$</th><th>Último documento</th><th class="num">Días</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="note" id="tablaNote"></div>
  </div>

</div>

<script>
/* ============================================================
   1. CONFIGURACIÓN
   ============================================================ */
const CFG = {
  URL_CSV : 'https://docs.google.com/spreadsheets/d/1LC9SUVf9GSQpfbNvjW0IEOS2Uuh_dkj6w4DXfVZAj9Y/gviz/tq?tqx=out:csv&sheet=cartera_29'
};

const HOY = new Date(); HOY.setHours(0,0,0,0);

const COLORES = {
  'AT'                    : '#16a34a',
  'En Evaluación'         : '#2563eb',
  'Espera Respuesta Obs.' : '#f59e0b',
  'Recepcionada'          : '#64748b',
  'Desestimado'           : '#dc2626',
  'Otros'                 : '#94a3b8',
  'Sin estado'            : '#cbd5e1'
};
const PALETA = ['#2563eb','#16a34a','#f59e0b','#dc2626','#7c3aed','#0d9488','#db2777','#0891b2','#65a30d','#ea580c','#4f46e5','#b45309'];

/* ============================================================
   2. UTILIDADES
   ============================================================ */
const norm = s => (s === undefined || s === null) ? '' : String(s).trim();

function parseDelimited(texto, delim){
  const filas = []; let fila = []; let campo = ''; let enQ = false;
  for (let i = 0; i < texto.length; i++){
    const c = texto[i];
    if (enQ){
      if (c === '"'){
        if (texto[i+1] === '"'){ campo += '"'; i++; }
        else enQ = false;
      } else campo += c;
    } else {
      if (c === '"') enQ = true;
      else if (c === delim){ fila.push(campo); campo = ''; }
      else if (c === '\n'){ fila.push(campo); filas.push(fila); fila = []; campo = ''; }
      else if (c === '\r'){ }
      else campo += c;
    }
  }
  if (campo !== '' || fila.length){ fila.push(campo); filas.push(fila); }
  return filas;
}

function csvAObjetos(texto){
  texto = texto.replace(/^\uFEFF/, '');
  const primera = texto.split('\n')[0] || '';
  const nTabs = (primera.match(/\t/g) || []).length;
  const nComas = (primera.match(/,/g) || []).length;
  const delim = nTabs > nComas ? '\t' : ',';
  const filas = parseDelimited(texto, delim).filter(f => f.some(x => norm(x) !== ''));
  if (!filas.length) return [];
  const head = filas[0].map(h => norm(h).toLowerCase().replace(/\s+/g,'_'));
  if (!head.includes('codigo_bip') && !head.includes('nombre')){
    throw new Error('El contenido no parece ser la hoja cartera_29.');
  }
  return filas.slice(1).map(f => {
    const o = {};
    head.forEach((h, i) => o[h] = norm(f[i]));
    return o;
  });
}

function parseFecha(s){
  const m = norm(s).match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
  if (!m) return null;
  let d = +m[1], mo = +m[2], y = +m[3];
  if (y < 100) y += 2000;
  if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  const dt = new Date(y, mo - 1, d);
  return isNaN(dt.getTime()) ? null : dt;
}

function parseMonto(v){
  const s = norm(v).replace(/\./g, '').replace(',', '.');
  const n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

function estadoNorm(e){
  const s = norm(e).toLowerCase();
  if (!s) return 'Sin estado';
  if (s === 'at' || s.startsWith('at ')) return 'AT';
  if (s.startsWith('espera')) return 'Espera Respuesta Obs.';
  if (s.startsWith('en evaluaci')) return 'En Evaluación';
  if (s.startsWith('desestim')) return 'Desestimado';
  if (s.startsWith('recepcion')) return 'Recepcionada';
  if (s.startsWith('otros')) return 'Otros';
  return norm(e);
}

function tipoNorm(r){
  let t = norm(r.tipologia_cartera_29) || norm(r.tipo_iniciativa);
  const s = t.toLowerCase();
  if (!s) return 'Sin tipología';
  if (s.includes('dos porciento') || s.includes('emergencia')) return 'Emergencia';
  if (s.includes('maquinaria')) return 'Maquinaria';
  if (s.includes('salud')) return 'Salud';
  if (s.includes('escolar')) return 'Escolar';
  if (s.includes('bomberos')) return 'Bomberos';
  if (s.includes('rsd') || s.includes('residuo')) return 'RSD';
  if (s.includes('accesibilidad')) return 'Accesibilidad';
  if (s.includes('veh')) return 'Vehículos';
  if (s.includes('aljibe') || s.includes('algibe')) return 'Aljibe';
  if (s.includes('electro')) return 'Electro';
  return t;
}

function extraerDocs(r){
  const docs = [];
  for (let i = 1; i <= 4; i++){
    const f  = parseFecha(r['f_' + i]);
    if (f) docs.push({ tipo: norm(r['t_' + i]) || 'Doc', num: norm(r['o_' + i]), fecha: f, etapa: 'Ingreso' });
    const fr = parseFecha(r['f_r_' + i]);
    if (fr) docs.push({ tipo: norm(r['t_r_' + i]) || 'Doc', num: norm(r['o_r_' + i]), fecha: fr, etapa: 'Respuesta' });
  }
  const fat = parseFecha(r['fecha_at']);
  if (fat) docs.push({ tipo: norm(r['tipo_doc_at']) || 'AT', num: norm(r['num_doc_at']), fecha: fat, etapa: 'AT' });
  return docs;
}

const fmtMM = n => new Intl.NumberFormat('es-CL', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(n);
const fmtN  = n => new Intl.NumberFormat('es-CL').format(n);
const fmtF  = d => d ? d.toLocaleDateString('es-CL', { day:'2-digit', month:'2-digit', year:'numeric' }) : '—';
const dias  = d => Math.round((HOY - d) / 86400000);

/* ============================================================
   3. PROCESAMIENTO
   ============================================================ */
let DATA = [];
let DATA_ALL = [];

function procesar(raw){
  return raw.map(r => {
    const docs = extraerDocs(r);
    let lastDoc = null;
    docs.forEach(d => { if (!lastDoc || d.fecha > lastDoc.fecha) lastDoc = d; });
    const diasSin = lastDoc ? dias(lastDoc.fecha) : null;
    return {
      bip       : norm(r.codigo_bip) || 'S/C',
      nombre    : norm(r.nombre),
      comuna    : norm(r.comuna) || '—',
      formulador: norm(r.formulador) || '—',
      monto     : parseMonto(r.monto_total_m),
      estado    : estadoNorm(r.estado),
      evaluador : norm(r.evaluador) || 'Sin asignar',
      tipo      : tipoNorm(r),
      obs       : norm(r.observaciones),
      docs      : docs,
      lastDoc   : lastDoc,
      diasSin   : diasSin
    };
  }).filter(x => x.nombre || x.bip !== 'S/C');
}

/* ============================================================
   4. FILTROS
   ============================================================ */
const el = id => document.getElementById(id);

function llenarSelect(sel, valores){
  const actual = sel.value;
  const uniq = [...new Set(valores)].filter(v => v && v !== '—').sort((a,b)=>a.localeCompare(b,'es'));
  sel.innerHTML = '<option value="">Todos</option>' + uniq.map(v => `<option value="${v}">${v}</option>`).join('');
  if (uniq.includes(actual)) sel.value = actual;
}

function aplicarFiltros(){
  const fe = el('fEstado').value, fv = el('fEval').value,
        ft = el('fTipo').value,   fc = el('fComuna').value,
        fx = el('fText').value.trim().toLowerCase();

  DATA = DATA_ALL.filter(r =>
    (!fe || r.estado === fe) &&
    (!fv || r.evaluador === fv) &&
    (!ft || r.tipo === ft) &&
    (!fc || r.comuna === fc || r.formulador === fc) &&
    (!fx || r.nombre.toLowerCase().includes(fx) || r.bip.toLowerCase().includes(fx))
  );
  renderTodo();
}

/* ============================================================
   5. GRÁFICOS
   ============================================================ */
const charts = {};
function draw(id, cfg){
  if (charts[id]) charts[id].destroy();
  charts[id] = new Chart(el(id).getContext('2d'), cfg);
}
const sinLeyenda = { legend: { display: false } };
const ejeX = { grid: { display: false }, ticks: { font: { size: 11 }, maxRotation: 45, minRotation: 0 } };
const ejeY = { grid: { color: '#eef2f7' }, ticks: { font: { size: 11 } } };

function agrupar(arr, keyFn, valFn){
  const m = new Map();
  arr.forEach(r => {
    const k = keyFn(r);
    if (k === null || k === undefined || k === '') return;
    m.set(k, (m.get(k) || 0) + (valFn ? valFn(r) : 1));
  });
  return m;
}
const ordenarDesc = m => [...m.entries()].sort((a,b) => b[1] - a[1]);

function renderTodo(){
  renderKPIs();
  renderEstado();
  renderComunas();
  renderTipologia();
  renderEvaluador();
  renderFormulador();
  renderRango();
  renderDocsMes();
  renderDias();
  renderTabla();
}

function renderKPIs(){
  const n = DATA.length;
  const monto = DATA.reduce((s,r) => s + r.monto, 0);
  const prom = n ? monto / n : 0;
  const cnt = e => DATA.filter(r => r.estado === e).length;
  const sinResp = DATA.filter(r => /sin respuesta/i.test(r.obs)).length;
  const comunas = new Set(DATA.map(r => r.comuna).filter(c => c && c !== '—')).size;
  const pct = x => n ? (x * 100 / n).toFixed(1) + '%' : '0%';

  const cards = [
    { v: fmtN(n),            l: 'Iniciativas',        c: '' },
    { v: fmtMM(monto),       l: 'Monto total (MM$)',  c: 'g' },
    { v: fmtMM(prom),        l: 'Monto promedio (MM$)', c: 't' },
    { v: pct(cnt('En Evaluación')), l: 'En evaluación', c: '' },
    { v: pct(cnt('AT')),     l: 'En AT',              c: 'g' },
    { v: pct(cnt('Desestimado')), l: 'Desestimadas',  c: 'r' },
    { v: fmtN(sinResp),      l: 'Sin respuesta',      c: 'a' },
    { v: fmtN(comunas),      l: 'Comunas cubiertas',  c: 'v2' }
  ];
  el('kpis').innerHTML = cards.map(k =>
    `<div class="kpi ${k.c}"><div class="v">${k.v}</div><div class="l">${k.l}</div></div>`
  ).join('');
}

function renderEstado(){
  const m = agrupar(DATA, r => r.estado);
  const ent = [...m.entries()].sort((a,b) => b[1] - a[1]);
  draw('chEstado', {
    type: 'doughnut',
    data: {
      labels: ent.map(e => e[0]),
      datasets: [{
        data: ent.map(e => e[1]),
        backgroundColor: ent.map(e => COLORES[e[0]] || '#94a3b8'),
        borderWidth: 2, borderColor: '#fff'
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: '58%',
      plugins: {
        legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } },
        tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed} (${(c.parsed/DATA.length*100).toFixed(1)}%)` } }
      }
    }
  });
}

function renderComunas(){
  const m = agrupar(DATA, r => r.comuna, r => r.monto);
  const top = ordenarDesc(m).filter(e => e[0] !== '—').slice(0, 10);
  draw('chComunas', {
    type: 'bar',
    data: {
      labels: top.map(e => e[0]),
      datasets: [{ data: top.map(e => +e[1].toFixed(1)), backgroundColor: '#2563eb', borderRadius: 5 }]
    },
    options: {
      indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${fmtMM(c.parsed.x)} MM$` } } },
      scales: { x: ejeY, y: { grid: { display: false }, ticks: { font: { size: 11 } } } }
    }
  });
}

function renderTipologia(){
  const m = agrupar(DATA, r => r.tipo, r => r.monto);
  const top = ordenarDesc(m).slice(0, 12);
  draw('chTipologia', {
    type: 'bar',
    data: {
      labels: top.map(e => e[0]),
      datasets: [{ data: top.map(e => +e[1].toFixed(1)), backgroundColor: top.map((_,i) => PALETA[i % PALETA.length]), borderRadius: 5 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${fmtMM(c.parsed.y)} MM$` } } },
      scales: { x: ejeX, y: ejeY }
    }
  });
}

function renderEvaluador(){
  const eval_ = [...new Set(DATA.map(r => r.evaluador))].sort((a,b)=>a.localeCompare(b,'es'));
  const est   = Object.keys(COLORES).filter(e => DATA.some(r => r.estado === e));
  const ds = est.map(e => ({
    label: e,
    data: eval_.map(v => DATA.filter(r => r.evaluador === v && r.estado === e).length),
    backgroundColor: COLORES[e],
    borderRadius: 3
  }));
  draw('chEval', {
    type: 'bar',
    data: { labels: eval_.map(v => v.split(' ')[0] + ' ' + (v.split(' ')[1] || '')), datasets: ds },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 11, font: { size: 10 } } } },
      scales: { x: { stacked: true, grid: { display: false }, ticks: { font: { size: 10 }, maxRotation: 40 } },
                y: { stacked: true, ...ejeY } }
    }
  });
}

function renderFormulador(){
  const m = agrupar(DATA, r => r.formulador, r => r.monto);
  const top = ordenarDesc(m).slice(0, 10);
  draw('chForm', {
    type: 'bar',
    data: {
      labels: top.map(e => e[0].replace('Municipalidad de ', 'M. ')),
      datasets: [{ data: top.map(e => +e[1].toFixed(1)), backgroundColor: '#0d9488', borderRadius: 5 }]
    },
    options: {
      indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${fmtMM(c.parsed.x)} MM$` } } },
      scales: { x: ejeY, y: { grid: { display: false }, ticks: { font: { size: 11 } } } }
    }
  });
}

function renderRango(){
  const rangos = [
    { l: '0 – 100 MM$',   f: r => r.monto < 100 },
    { l: '100 – 300 MM$', f: r => r.monto >= 100 && r.monto < 300 },
    { l: '300 – 600 MM$', f: r => r.monto >= 300 && r.monto < 600 },
    { l: '600 – 1000 MM$',f: r => r.monto >= 600 && r.monto < 1000 },
    { l: '> 1000 MM$',    f: r => r.monto >= 1000 }
  ];
  draw('chRango', {
    type: 'bar',
    data: {
      labels: rangos.map(x => x.l),
      datasets: [{
        data: rangos.map(x => DATA.filter(x.f).length),
        backgroundColor: ['#93c5fd','#60a5fa','#3b82f6','#2563eb','#1e40af'],
        borderRadius: 5
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${c.parsed.y} iniciativas` } } },
      scales: { x: ejeX, y: ejeY }
    }
  });
}

function renderDocsMes(){
  const m = new Map();
  DATA.forEach(r => r.docs.forEach(d => {
    const k = d.fecha.getFullYear() + '-' + String(d.fecha.getMonth()+1).padStart(2,'0');
    m.set(k, (m.get(k) || 0) + 1);
  }));
  const keys = [...m.keys()].sort().slice(-18);
  draw('chDocsMes', {
    type: 'bar',
    data: {
      labels: keys.map(k => {
        const [y, mo] = k.split('-');
        return ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'][+mo-1] + ' ' + y.slice(2);
      }),
      datasets: [{ data: keys.map(k => m.get(k)), backgroundColor: '#7c3aed', borderRadius: 5 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${c.parsed.y} documentos` } } },
      scales: { x: ejeX, y: ejeY }
    }
  });
}

function renderDias(){
  const top = DATA.filter(r => r.diasSin !== null)
                  .sort((a,b) => b.diasSin - a.diasSin).slice(0, 10);
  draw('chDias', {
    type: 'bar',
    data: {
      labels: top.map(r => (r.nombre.length > 42 ? r.nombre.slice(0,42) + '…' : r.nombre)),
      datasets: [{
        data: top.map(r => r.diasSin),
        backgroundColor: top.map(r => r.diasSin > 90 ? '#dc2626' : r.diasSin > 30 ? '#f59e0b' : '#16a34a'),
        borderRadius: 5
      }]
    },
    options: {
      indexAxis: 'y', responsive: true, maintainAspectRatio: false,
      plugins: { ...sinLeyenda, tooltip: { callbacks: { label: c => ` ${c.parsed.x} días sin movimiento` } } },
      scales: { x: ejeY, y: { grid: { display: false }, ticks: { font: { size: 10 } } } }
    }
  });
}

const claseEstado = e => ({
  'AT':'p-at','En Evaluación':'p-ev','Espera Respuesta Obs.':'p-es',
  'Desestimado':'p-de','Recepcionada':'p-re','Otros':'p-ot','Sin estado':'p-ot'
}[e] || 'p-ot');

function renderTabla(){
  const filas = [...DATA].sort((a,b) => (b.diasSin ?? -1) - (a.diasSin ?? -1)).slice(0, 60);
  el('tabla').querySelector('tbody').innerHTML = filas.map(r => {
    let cls = 'd-ok', txt = r.diasSin;
    if (r.diasSin === null){ cls = 'd-mid'; txt = 's/f'; }
    else if (r.diasSin < 0){ cls = 'd-mid'; txt = 'futura'; }
    else if (r.diasSin > 90) cls = 'd-bad';
    else if (r.diasSin > 30) cls = 'd-mid';

    const doc = r.lastDoc
      ? `${r.lastDoc.tipo}${r.lastDoc.num ? ' N°' + r.lastDoc.num : ''} · ${fmtF(r.lastDoc.fecha)}`
      : '—';

    return `<tr>
      <td><b>${r.bip}</b></td>
      <td title="${r.obs.replace(/"/g,'&quot;')}">${r.nombre.length > 70 ? r.nombre.slice(0,70) + '…' : r.nombre}</td>
      <td>${r.comuna}</td>
      <td>${r.formulador.replace('Municipalidad de ','M. ')}</td>
      <td>${r.tipo}</td>
      <td><span class="pill ${claseEstado(r.estado)}">${r.estado}</span></td>
      <td>${r.evaluador}</td>
      <td class="num">${fmtMM(r.monto)}</td>
      <td>${doc}</td>
      <td class="num ${cls}">${txt}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="10" style="text-align:center;color:#94a3b8;padding:24px">Sin resultados con los filtros aplicados</td></tr>';

  el('tablaNote').textContent = `Mostrando ${filas.length} de ${DATA.length} iniciativas filtradas (total en cartera: ${DATA_ALL.length}).`;
}

