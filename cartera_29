function setBadge(txt, cls){
  const b = el('srcBadge');
  b.textContent = txt;
  b.className = 'badge ' + (cls || '');
}

function cargarDatos(raw, origen){
  DATA_ALL = procesar(raw);
  llenarSelect(el('fEstado'), DATA_ALL.map(r => r.estado));
  llenarSelect(el('fEval'),   DATA_ALL.map(r => r.evaluador));
  llenarSelect(el('fTipo'),   DATA_ALL.map(r => r.tipo));
  llenarSelect(el('fComuna'), [...DATA_ALL.map(r => r.comuna), ...DATA_ALL.map(r => r.formulador)]);
  el('fEstado').value = ''; el('fEval').value = ''; el('fTipo').value = ''; el('fComuna').value = ''; el('fText').value = '';
  el('errBox').classList.add('hidden');
  DATA = [...DATA_ALL];
  renderTodo();
  setBadge('● ' + origen, origen.includes('Ejemplo') ? 'warn' : 'ok');
  el('updBadge').textContent = 'Actualizado ' + new Date().toLocaleTimeString('es-CL', {hour:'2-digit', minute:'2-digit'});
}

async function cargarDatosRemotos(){
  setBadge('⏳ Cargando…', 'warn');
  try {
    const resp = await fetch(CFG.URL_CSV, { cache: 'no-store' });
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const texto = await resp.text();
    const raw = csvAObjetos(texto);
    if (!raw.length) throw new Error('La hoja está vacía o no se pudo leer.');
    cargarDatos(raw, 'Datos en línea');
  } catch (e){
    el('errBox').classList.remove('hidden');
    el('errBox').innerHTML =
      `<b>No se pudieron leer los datos en línea.</b> Se muestran datos de ejemplo para que veas el dashboard funcionando.<br>
       Para conectar con los datos reales, comparte la hoja como <i>Cualquier persona con el enlace → Lector</i> 
       (o publícala como CSV) y recarga esta página.`;
    cargarDatos(DEMO, 'Ejemplo (sin conexión)');
  }
}

