<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Validador de Datos · Carteras FNDR 2026</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root{--bg:#f1f5f9;--card:#fff;--line:#e2e8f0;--txt:#0f172a;--muted:#64748b;
    --alta:#dc2626;--media:#f59e0b;--baja:#3b82f6;--ok:#16a34a;--azul:#2563eb}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--txt);padding:18px}
  h1{font-size:1.5rem;color:#0b3a6f;margin-bottom:4px}
  .sub{font-size:.88rem;color:var(--muted);margin-bottom:16px}
  .wrap{max-width:1600px;margin:0 auto}
  .nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;background:var(--card);padding:10px 14px;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.06);align-items:center}
  .nav .lbl{font-size:.75rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-right:6px}
  .nav button{padding:7px 14px;border:1px solid var(--line);background:#f8fafc;border-radius:8px;font-weight:600;font-size:.85rem;cursor:pointer;font-family:inherit;color:#334155;transition:.15s}
  .nav button:hover{background:#e0f2fe;border-color:var(--azul)}
  .nav button.activo{background:var(--azul);color:#fff;border-color:var(--azul);box-shadow:0 2px 6px rgba(37,99,235,.3)}
  .nav button.vista.activo{background:#7c3aed;border-color:#7c3aed;box-shadow:0 2px 6px rgba(124,58,237,.3)}
  .filtros{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;background:var(--card);padding:14px 16px;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.06);margin-bottom:16px}
  .filtros label{display:flex;flex-direction:column;gap:4px}
  .filtros label span{font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
  .filtros select,.filtros input{padding:7px 10px;border:1px solid var(--line);border-radius:7px;font-size:.88rem;background:#fff;font-family:inherit;color:var(--txt)}
  .filtros select:focus,.filtros input:focus{outline:none;border-color:var(--azul);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
  .filtros .acciones{display:flex;gap:8px;align-items:end}
  .filtros button{padding:8px 14px;border:none;border-radius:7px;font-weight:600;font-size:.85rem;cursor:pointer;font-family:inherit}
  .btn-primary{background:var(--azul);color:#fff}
  .btn-primary:hover{background:#1d4ed8}
  .btn-ghost{background:#fff;color:var(--azul);border:1px solid var(--azul)!important}
  .btn-ghost:hover{background:#eff6ff}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}
  .kpi{background:var(--card);border-radius:10px;padding:14px 16px;border-left:4px solid var(--azul);box-shadow:0 1px 3px rgba(0,0,0,.06)}
  .kpi .v{font-size:1.6rem;font-weight:700;line-height:1}
  .kpi .l{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:4px;font-weight:600}
  .kpi.alta{border-left-color:var(--alta)}.kpi.media{border-left-color:var(--media)}
  .kpi.baja{border-left-color:var(--baja)}.kpi.ok{border-left-color:var(--ok)}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
  @media(max-width:1000px){.grid{grid-template-columns:1fr}}
  .card{background:var(--card);border-radius:10px;padding:14px 16px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
  .card h3{font-size:.9rem;color:#334155;margin-bottom:10px;font-weight:600}
  .cvs{position:relative;height:340px}
  .tabla-card{background:var(--card);border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden}
  .tabla-card h3{padding:14px 16px;font-size:.9rem;color:#334155;border-bottom:1px solid var(--line);font-weight:600;display:flex;justify-content:space-between;align-items:center}
  .tabla-card h3 .count{font-size:.78rem;color:var(--muted);font-weight:500}
  .scroll{max-height:640px;overflow:auto}
  table{width:100%;border-collapse:collapse;font-size:.82rem}
  th{position:sticky;top:0;background:#f8fafc;padding:9px 10px;text-align:left;font-size:.7rem;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);border-bottom:2px solid var(--line);font-weight:700;z-index:1}
  td{padding:8px 10px;border-bottom:1px solid #f1f5f9;vertical-align:top}
  tr:hover td{background:#f8fafc}
  .pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:.7rem;font-weight:700;white-space:nowrap}
  .p-alta{background:#fee2e2;color:#b91c1c}
  .p-media{background:#fef3c7;color:#b45309}
  .p-baja{background:#dbeafe;color:#1d4ed8}
  .tag{display:inline-block;padding:1px 7px;border-radius:5px;font-size:.68rem;font-weight:600;background:#e2e8f0;color:#475569}
  .formulador{font-weight:600;color:#0f172a}
  .hoja{font-size:.72rem;color:var(--muted)}
  .codigo{font-family:ui-monospace,monospace;font-size:.78rem}
  .detalle{font-size:.76rem;color:#475569;max-width:340px}
  .vacio{text-align:center;padding:40px;color:var(--muted)}

  /* Vista por evaluador */
  .eval-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(460px,1fr));gap:16px}
  .eval-card{background:var(--card);border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.08);overflow:hidden;border-top:4px solid var(--azul);display:flex;flex-direction:column}
  .eval-card.alta{border-top-color:var(--alta)}
  .eval-card.media{border-top-color:var(--media)}
  .eval-card.baja{border-top-color:var(--baja)}
  .eval-head{padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid var(--line);background:#fbfcfe}
  .eval-head h3{font-size:.95rem;color:#0b3a6f;font-weight:700;margin:0}
  .eval-head .badges{display:flex;gap:6px;flex-wrap:wrap}
  .badge{padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;white-space:nowrap}
  .badge.alta{background:#fee2e2;color:#b91c1c}
  .badge.media{background:#fef3c7;color:#b45309}
  .badge.baja{background:#dbeafe;color:#1d4ed8}
  .badge.total{background:#e2e8f0;color:#334155}
  .eval-actions{padding:10px 16px;border-bottom:1px solid var(--line);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .eval-actions button{padding:6px 12px;border-radius:6px;font-size:.78rem;font-weight:600;cursor:pointer;font-family:inherit;border:1px solid var(--line);background:#fff;color:#334155}
  .eval-actions button.primary{background:var(--azul);color:#fff;border-color:var(--azul)}
  .eval-actions button.primary:hover{background:#1d4ed8}
  .eval-actions button:hover{background:#f1f5f9}
  .eval-list{padding:8px 12px;overflow:auto;max-height:440px}
  .err-item{padding:9px 12px;border-radius:8px;border-left:3px solid var(--baja);background:#f8fafc;margin-bottom:6px;font-size:.78rem}
  .err-item.alta{border-left-color:var(--alta);background:#fef2f2}
  .err-item.media{border-left-color:var(--media);background:#fffbeb}
  .err-item.baja{border-left-color:var(--baja)}
  .err-item .err-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap}
  .err-item .err-regla{font-weight:700;color:#0f172a;font-size:.78rem}
  .err-item .err-bip{font-family:ui-monospace,monospace;font-size:.72rem;color:var(--muted)}
  .err-item .err-nombre{color:#334155;font-size:.75rem;margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .err-item .err-detalle{color:#64748b;font-size:.72rem}
  .err-item .err-formu{color:#0f172a;font-size:.72rem;font-weight:600}
  .err-item .err-hoja{font-size:.65rem;background:#e2e8f0;color:#475569;padding:1px 6px;border-radius:4px;font-weight:600;margin-right:4px}
  .eval-vacio{padding:20px;text-align:center;color:var(--muted);font-size:.82rem}
  .msg{padding:14px 18px;border-radius:8px;margin-bottom:16px;font-size:.88rem}
  .msg.info{background:#eff6ff;color:#1e40af;border-left:4px solid var(--azul)}
  .msg.err{background:#fef2f2;color:#991b1b;border-left:4px solid var(--alta)}
  .msg.ok{background:#f0fdf4;color:#15803d;border-left:4px solid var(--ok)}
  .hidden{display:none!important}
</style>
</head>
<body>
<div class="wrap">
  <h1>🛡️ Validador de Datos · Carteras FNDR 2026</h1>
  <p class="sub">Detección de inconsistencias en <b>preinversion</b>, <b>circular_18</b>, <b>admisibilidad_mideso</b> y <b>cartera_29</b> · Agrupadas por <b>evaluador</b></p>

  <div id="msgBox"></div>

  <nav class="nav" id="navHojas">
    <span class="lbl">Hoja:</span>
    <button data-hoja="TODAS" class="activo">📚 Todas</button>
    <button data-hoja="preinversion">📈 Preinversión</button>
    <button data-hoja="circular_18">📋 Circular 18</button>
    <button data-hoja="admisibilidad_mideso">✅ Admisibilidad MIDESO</button>
    <button data-hoja="cartera_29">🗂️ Cartera 29</button>
  </nav>

  <nav class="nav" id="navVista">
    <span class="lbl">Vista:</span>
    <button data-vista="detalle" class="vista activo">📋 Detalle de errores</button>
    <button data-vista="evaluador" class="vista">👤 Por evaluador</button>
  </nav>

  <!-- ===== VISTA DETALLE ===== -->
  <div id="vistaDetalle">
    <div class="filtros">
      <label><span>Evaluador</span><select id="fEvaluador"><option value="">Todos</option></select></label>
      <label><span>Formulador</span><select id="fFormulador"><option value="">Todos</option></select></label>
      <label><span>Severidad</span>
        <select id="fSeveridad">
          <option value="">Todas</option><option value="Alta">🔴 Alta</option>
          <option value="Media">🟠 Media</option><option value="Baja">🔵 Baja</option>
        </select>
      </label>
      <label><span>Tipo de error</span><select id="fRegla"><option value="">Todos</option></select></label>
      <label><span>Buscar (BIP o nombre)</span><input id="fTexto" placeholder="texto…"></label>
      <div class="acciones">
        <button class="btn-primary" id="btnReload">🔄 Recargar</button>
        <button class="btn-ghost" id="btnExport">📥 Exportar CSV</button>
      </div>
    </div>

    <div class="kpis" id="kpis"></div>

    <div class="grid">
      <div class="card"><h3>Errores por tipo de regla</h3><div class="cvs"><canvas id="chReglas"></canvas></div></div>
      <div class="card"><h3>Top 12 evaluadores con más errores</h3><div class="cvs"><canvas id="chEvaluadores"></canvas></div></div>
    </div>

    <div class="tabla-card">
      <h3><span>🔍 Detalle de inconsistencias detectadas</span><span class="count" id="tablaCount">—</span></h3>
      <div class="scroll">
        <table>
          <thead><tr>
            <th style="width:90px">Severidad</th><th style="width:130px">Tipo error</th>
            <th style="width:80px">Hoja</th><th style="width:90px">BIP</th>
            <th>Iniciativa</th><th style="width:150px">Evaluador</th>
            <th style="width:170px">Formulador</th><th style="width:110px">Comuna</th>
            <th>Detalle</th>
          </tr></thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ===== VISTA POR EVALUADOR ===== -->
  <div id="vistaEvaluador" class="hidden">
    <div class="filtros">
      <label><span>Severidad</span>
        <select id="fSeveridad2">
          <option value="">Todas</option><option value="Alta">🔴 Alta</option>
          <option value="Media">🟠 Media</option><option value="Baja">🔵 Baja</option>
        </select>
      </label>
      <label><span>Tipo de error</span><select id="fRegla2"><option value="">Todos</option></select></label>
      <label><span>Formulador</span><select id="fFormulador2"><option value="">Todos</option></select></label>
      <label><span>Ordenar por</span>
        <select id="fOrden2">
          <option value="alta">Más errores alta</option>
          <option value="total">Más errores totales</option>
          <option value="nombre">Nombre (A-Z)</option>
        </select>
      </label>
      <div class="acciones">
        <button class="btn-primary" id="btnExportTodos">📦 Exportar todo (CSV por evaluador)</button>
      </div>
    </div>

    <div class="kpis" id="kpis2"></div>

    <div style="margin-bottom:16px">
      <input id="buscarEvaluador" placeholder="🔎 Buscar evaluador…" style="width:100%;padding:10px 14px;border:1px solid var(--line);border-radius:8px;font-size:.9rem;font-family:inherit">
    </div>

    <div class="eval-grid" id="evalGrid"></div>
  </div>

</div>

<script>
/* ============================================================
   CONFIG
   ============================================================ */
const SPREADSHEET_ID = '1LC9SUVf9GSQpfbNvjW0IEOS2Uuh_dkj6w4DXfVZAj9Y';
const HOJAS = ['preinversion','circular_18','admisibilidad_mideso','cartera_29'];
const HOY = new Date(); HOY.setHours(0,0,0,0);

const COMUNA_POR_MUNI = {
  'Municipalidad de Angol':'Angol','Municipalidad de Carahue':'Carahue','Municipalidad de Cholchol':'Cholchol',
  'Municipalidad de Collipulli':'Collipulli','Municipalidad de Cunco':'Cunco','Municipalidad de Curacautín':'Curacautín',
  'Municipalidad de Curarrehue':'Curarrehue','Municipalidad de Ercilla':'Ercilla','Municipalidad de Freire':'Freire',
  'Municipalidad de Galvarino':'Galvarino','Municipalidad de Gorbea':'Gorbea','Municipalidad de Lautaro':'Lautaro',
  'Municipalidad de Loncoche':'Loncoche','Municipalidad de Lonquimay':'Lonquimay','Municipalidad de Los Sauces':'Los Sauces',
  'Municipalidad de Lumaco':'Lumaco','Municipalidad de Melipeuco':'Melipeuco','Municipalidad de Nueva Imperial':'Nueva Imperial',
  'Municipalidad de Padre Las Casas':'Padre Las Casas','Municipalidad de Perquenco':'Perquenco','Municipalidad de Pitrufquén':'Pitrufquén',
  'Municipalidad de Pucón':'Pucón','Municipalidad de Purén':'Purén','Municipalidad de Renaico':'Renaico',
  'Municipalidad de Puerto Saavedra':'Puerto Saavedra','Municipalidad de Temuco':'Temuco','Municipalidad de Teodoro Schmidt':'Teodoro Schmidt',
  'Municipalidad de Toltén':'Toltén','Municipalidad de Traiguén':'Traiguén','Municipalidad de Victoria':'Victoria',
  'Municipalidad de Vilcún':'Vilcún','Municipalidad de Villarrica':'Villarrica'
};
const COMUNAS_VALIDAS = new Set(Object.values(COMUNA_POR_MUNI));
const TIPOS_DOC_VALIDOS = new Set(['Ordinario','Memorándum','Memorandum','Mail','Circular','Reservado','Conductor']);

/* ============================================================
   UTILIDADES
   ============================================================ */
const el = id => document.getElementById(id);
const norm = s => (s==null?'':String(s)).trim();
const normKey = s => norm(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')
  .replace(/\s+/g,'_').replace(/[^\w_]/g,'').replace(/^_|_$/g,'');
const limpiarBIP = s => norm(s).replace(/\.0+$/,'').replace(/\s/g,'');

function parseFechaFlex(s){
  const str = norm(s);
  if (!str) return null;
  let m = str.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (m){ const d = new Date(+m[1],+m[2]-1,+m[3]); return isNaN(d)?null:d; }
  m = str.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
  if (m){
    let d=+m[1], mo=+m[2], y=+m[3];
    if (y<100) y += y<70 ? 2000 : 1900;
    if (mo>=1&&mo<=12&&d>=1&&d<=31){ const dt=new Date(y,mo-1,d); return isNaN(dt)?null:dt; }
  }
  return null;
}

function parseNumFlex(v){
  if (v === '' || v == null) return null;
  if (typeof v === 'number') return v;
  let s = String(v).trim().replace(/\$/g,'').replace(/\s/g,'');
  if (!s) return null;
  if (/^-?\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g,'');
  else if (/^-?\d{1,3}(,\d{3})+$/.test(s)) s = s.replace(/,/g,'');
  else if (/,/.test(s) && /\./.test(s)) s = s.replace(/\./g,'').replace(',','.');
  else if (/,/.test(s) && /^\d+,\d+$/.test(s)) s = s.replace(',','.');
  const n = Number(s);
  return isNaN(n) ? null : n;
}

function esFechaSentinel(d){ return d && d.getFullYear() <= 1970; }
function esFechaFutura(d, mesesTol = 6){
  if (!d) return false;
  const lim = new Date(HOY); lim.setMonth(lim.getMonth() + mesesTol);
  return d > lim;
}
function fmtFecha(d){ return d ? d.toLocaleDateString('es-CL') : '—'; }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

/* ============================================================
   CARGA (JSONP)
   ============================================================ */
let jsonpN = 0;
function cargarHoja(nombre){
  return new Promise((resolve,reject) => {
    const cb = 'vizcb_' + (++jsonpN);
    const url = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=responseHandler:${cb}&sheet=${encodeURIComponent(nombre)}`;
    const s = document.createElement('script');
    s.src = url;
    const to = setTimeout(()=>{limpiar();reject(new Error('Timeout '+nombre))}, 15000);
    function limpiar(){ clearTimeout(to); if(s.parentNode) s.parentNode.removeChild(s); try{delete window[cb]}catch(e){window[cb]=undefined} }
    window[cb] = resp => {
      limpiar();
      if (!resp || !resp.table){ reject(new Error('Sin tabla '+nombre)); return; }
      resolve(resp.table);
    };
    s.onerror = () => { limpiar(); reject(new Error('Error de red '+nombre)); };
    document.head.appendChild(s);
  });
}

function valorCelda(c){
  if (!c) return '';
  if (c.f != null && c.f !== '') return String(c.f).trim();
  if (c.v instanceof Date) return c.v.toLocaleDateString('es-CL');
  if (c.v == null) return '';
  return c.v;
}

function tablaAFilas(table, hoja){
  if (!table || !table.cols || !table.rows) return [];
  const headsRaw = table.cols.map(c => norm(c.label || c.id || ''));
  const headsKey = headsRaw.map(normKey);
  const filas = [];
  table.rows.forEach(row => {
    if (!row || !row.c) return;
    const obj = {__hoja: hoja, __headRaw: headsRaw, __headKey: headsKey};
    headsKey.forEach((h,i) => { obj[h] = valorCelda(row.c[i]); });
    const tiene = headsKey.some(h => norm(obj[h]) !== '');
    if (tiene) filas.push(obj);
  });
  return filas;
}

function pick(obj, ...alias){
  for (const a of alias){
    const k = normKey(a);
    if (k in obj) return obj[k];
  }
  for (const a of alias){
    const k = normKey(a);
    for (const key of Object.keys(obj)){
      if (key.startsWith(k)) return obj[key];
    }
  }
  return '';
}

/* ============================================================
   NORMALIZACIÓN
   ============================================================ */
function extraerIteraciones(obj){
  const its = [];
  for (let i=1;i<=4;i++){
    const t  = pick(obj, 't_'+i);
    const o  = pick(obj, 'o_'+i);
    const f  = pick(obj, 'f_'+i);
    const tr = pick(obj, 't_r_'+i);
    const or = pick(obj, 'o_r_'+i);
    const fr = pick(obj, 'f_r_'+i);
    its.push({
      i,
      envio: {tipo:norm(t), num:norm(o), fechaStr:norm(f),  fecha:parseFechaFlex(f)},
      resp:  {tipo:norm(tr), num:norm(or), fechaStr:norm(fr), fecha:parseFechaFlex(fr)}
    });
  }
  return its;
}

function extraerBloquesAdm(obj){
  const bloques = [];
  for (let i=1;i<=4;i++){
    const tipoRecep = pick(obj, 'tipo_doc_recep'+i, 'tipo_doc_recep_'+i);
    const numRecep  = pick(obj, 'num_ord_recep'+i, 'num_ord_recep_'+i);
    const fAsig     = pick(obj, 'fecha_asignacion_evaluacion_admisibilidad_'+i, 'fecha_asignacion_evaluación_admisibilidad_'+i);
    const fRecep    = pick(obj, 'fecha_recepcion_'+i, 'fecha_recepción_'+i);
    const tipoEnvio = pick(obj, 'tipo_doc_envio_ob'+i);
    const numEnvio  = pick(obj, 'num_ord_envio_ob'+i);
    const fEnvio    = pick(obj, 'fecha_ord_envio_ob'+i);
    bloques.push({
      i,
      recepcion: {tipo:norm(tipoRecep), num:norm(numRecep), fechaAsigStr:norm(fAsig),
                   fechaAsig:parseFechaFlex(fAsig), fechaRecepStr:norm(fRecep), fechaRecep:parseFechaFlex(fRecep)},
      envioObs:  {tipo:norm(tipoEnvio), num:norm(numEnvio), fechaStr:norm(fEnvio), fecha:parseFechaFlex(fEnvio)}
    });
  }
  return bloques;
}

function normalizarFila(obj, hoja){
  const codigoRaw = pick(obj, 'codigo_bip', 'codigo_BIP', 'codigo');
  const codigo = limpiarBIP(codigoRaw);
  const montoRaw = pick(obj, 'monto_total_m$', 'monto_total_m', 'monto_total_ms', 'monto');
  const monto = parseNumFlex(montoRaw);
  const f = {
    __hoja: hoja,
    codigoRaw: norm(codigoRaw),
    codigo,
