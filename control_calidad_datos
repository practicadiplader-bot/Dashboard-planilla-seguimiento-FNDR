  const ord = el('fOrden2').value;
  let arr = [...grupos.values()];
  if (ord === 'alta') arr.sort((a,b) => b.alta - a.alta || b.media - a.media || b.items.length - a.items.length);
  else if (ord === 'total') arr.sort((a,b) => b.items.length - a.items.length);
  else arr.sort((a,b) => a.nombre.localeCompare(b.nombre,'es'));

  const cont = el('evalGrid');
  if (!arr.length){
    cont.innerHTML = '<div class="eval-vacio" style="grid-column:1/-1">Sin errores con los filtros aplicados</div>';
    return;
  }

  cont.innerHTML = arr.map(g => {
    const nivel = g.alta > 0 ? 'alta' : g.media > 0 ? 'media' : 'baja';
    const hojas = [...g.hojas].map(h => `<span class="err-hoja">${h}</span>`).join('');
    const items = g.items
      .sort((a,b) => {
        const o = {Alta:0,Media:1,Baja:2};
        return o[a.sev]-o[b.sev];
      })
      .map(e => `
        <div class="err-item ${e.sev.toLowerCase()}">
          <div class="err-head">
            <span class="err-regla">${esc(e.regla)}</span>
            <span class="err-bip">${esc(e.codigo) || '—'}</span>
          </div>
          <div class="err-formu">🏛️ ${esc(e.formulador) || '(sin formulador)'} · ${esc(e.comuna) || '(sin comuna)'}</div>
          <div class="err-nombre" title="${esc(e.nombre)}">${esc(e.nombre).slice(0,90)}${e.nombre.length>90?'…':''}</div>
          <div class="err-detalle">${esc(e.detalle)}</div>
        </div>`).join('');

    return `
      <div class="eval-card ${nivel}" data-evaluador="${esc(g.nombre)}">
        <div class="eval-head">
          <h3>👤 ${esc(g.nombre)}</h3>
          <div class="badges">
            ${g.alta ? `<span class="badge alta">${g.alta} alta</span>` : ''}
            ${g.media ? `<span class="badge media">${g.media} media</span>` : ''}
            ${g.baja ? `<span class="badge baja">${g.baja} baja</span>` : ''}
            <span class="badge total">${g.items.length} total</span>
          </div>
        </div>
        <div class="eval-actions">
          ${hojas}
          <span style="flex:1"></span>
          <span style="font-size:.72rem;color:#64748b">${g.formuladores.size} formulador${g.formuladores.size!==1?'es':''}</span>
          <button data-accion="copiar" data-evaluador="${esc(g.nombre)}">📋 Copiar lista</button>
          <button class="primary" data-accion="csv" data-evaluador="${esc(g.nombre)}">📥 Exportar CSV</button>
        </div>
        <div class="eval-list">${items}</div>
      </div>`;
  }).join('');

  cont.querySelectorAll('button[data-accion]').forEach(btn => {
    btn.addEventListener('click', () => {
      const nombre = btn.dataset.evaluador;
      const accion = btn.dataset.accion;
      const g = arr.find(x => x.nombre === nombre);
      if (!g) return;
      if (accion === 'csv') exportarEvaluadorCSV(g);
      else if (accion === 'copiar') copiarLista(g, btn);
    });
  });
}

/* ============================================================
   EXPORTAR
   ============================================================ */
function filaCSV(f) {
  return [
    f.sev, f.regla, f.__hoja, f.codigo, f.nombre, f.evaluador, f.formulador, f.comuna, f.estado,
    f.monto == null ? '' : f.monto, f.detalle
  ].map(v => {
    const s = String(v ?? '').replace(/"/g,'""');
    return /[",\n;]/.test(s) ? `"${s}"` : s;
  }).join(';');
}

function descargarCSV(nombre, contenido){
  const blob = new Blob(['\uFEFF' + contenido], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = nombre;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function nombreArchivoSeguro(s){
  return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^\w\s-]/g,'').trim().replace(/\s+/g,'_').slice(0,60);
}

function exportarEvaluadorCSV(g){
  const head = ['Severidad','Tipo error','Hoja','Código BIP','Iniciativa','Evaluador','Formulador','Comuna','Estado','Monto (M$)','Detalle'];
  const orden = {Alta:0,Media:1,Baja:2};
  const items = [...g.items].sort((a,b) => orden[a.sev]-orden[b.sev]);
  const csv = [head.join(';'), ...items.map(filaCSV)].join('\n');
  descargarCSV(`errores_${nombreArchivoSeguro(g.nombre)}_${new Date().toISOString().slice(0,10)}.csv`, csv);
}

function copiarLista(g, btn){
  const orden = {Alta:0,Media:1,Baja:2};
  const items = [...g.items].sort((a,b) => orden[a.sev]-orden[b.sev]);
  const txt = `Errores detectados · Evaluador: ${g.nombre}\n\n` +
    items.map(e => `[${e.sev}] ${e.regla} · ${e.__hoja} · BIP ${e.codigo || '—'}\n  Formulador: ${e.formulador || '(vacío)'} · ${e.comuna || ''}\n  ${e.nombre.slice(0,100)}\n  ${e.detalle}`).join('\n\n');

  const done = () => {
    const original = btn.textContent;
    btn.textContent = '✅ Copiado';
    setTimeout(() => { btn.textContent = original; }, 1500);
  };

  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = txt; document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta); done();
    });
  } else {
    const ta = document.createElement('textarea');
    ta.value = txt; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta); done();
  }
}

function exportarTodosCSV(){
  const datos = filtrarVistaEvaluador();
  const grupos = new Map();
  datos.forEach(e => {
    const k = e.evaluador || '(Sin evaluador)';
    if (!grupos.has(k)) grupos.set(k, []);
    grupos.get(k).push(e);
  });

  const head = ['Severidad','Tipo error','Hoja','Código BIP','Iniciativa','Evaluador','Formulador','Comuna','Estado','Monto (M$)','Detalle'];
  const orden = {Alta:0,Media:1,Baja:2};
  let out = '';
  [...grupos.keys()].sort((a,b)=>a.localeCompare(b,'es')).forEach(k => {
    out += `\n\n===== ${k} (${grupos.get(k).length} errores) =====\n`;
    out += head.join(';') + '\n';
    const items = [...grupos.get(k)].sort((a,b)=>orden[a.sev]-orden[b.sev]);
    items.forEach(e => { out += filaCSV(e) + '\n'; });
  });

  descargarCSV(`errores_por_evaluador_${new Date().toISOString().slice(0,10)}.csv`, out.trim());
}

/* ============================================================
   EVENTOS
   ============================================================ */
document.querySelectorAll('#navHojas button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#navHojas button').forEach(b => b.classList.remove('activo'));
    btn.classList.add('activo');
    hojaActiva = btn.dataset.hoja;
    render();
  });
});

document.querySelectorAll('#navVista button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#navVista button').forEach(b => b.classList.remove('activo'));
    btn.classList.add('activo');
    vistaActual = btn.dataset.vista;
    el('vistaDetalle').classList.toggle('hidden', vistaActual !== 'detalle');
    el('vistaEvaluador').classList.toggle('hidden', vistaActual !== 'evaluador');
    render();
  });
});

['fEvaluador','fFormulador','fSeveridad','fRegla'].forEach(id => el(id).addEventListener('change', render));
el('fTexto').addEventListener('input', render);
['fSeveridad2','fRegla2','fFormulador2','fOrden2'].forEach(id => el(id).addEventListener('change', render));
el('buscarEvaluador').addEventListener('input', render);
el('btnReload').addEventListener('click', cargarTodo);

el('btnExport').addEventListener('click', () => {
  const datos = filtrarBase();
  if (!datos.length){ alert('No hay inconsistencias para exportar'); return; }
  const head = ['Severidad','Tipo error','Hoja','Código BIP','Iniciativa','Evaluador','Formulador','Comuna','Estado','Monto (M$)','Detalle'];
  const csv = [head.join(';'), ...datos.map(filaCSV)].join('\n');
  descargarCSV(`inconsistencias_${hojaActiva}_${new Date().toISOString().slice(0,10)}.csv`, csv);
});

el('btnExportTodos').addEventListener('click', exportarTodosCSV);

cargarTodo();
</script>
