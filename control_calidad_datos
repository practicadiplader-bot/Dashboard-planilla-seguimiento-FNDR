  datos.forEach(e => mR.set(e.regla, (mR.get(e.regla)||0)+1));
  const rOrd = [...mR.entries()].sort((a,b)=>b[1]-a[1]).slice(0,12);
  if (charts.chReglas) charts.chReglas.destroy();
  charts.chReglas = new Chart(el('chReglas').getContext('2d'), {
    type:'bar',
    data:{ labels: rOrd.map(x=>x[0]),
      datasets:[{ data: rOrd.map(x=>x[1]),
        backgroundColor: rOrd.map(x => {
          const filas = datos.filter(d=>d.regla===x[0]);
          if (filas.some(f=>f.sev==='Alta')) return '#dc2626';
          if (filas.some(f=>f.sev==='Media')) return '#f59e0b';
          return '#3b82f6';
        }), borderRadius:5 }] },
    options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ x:{ beginAtZero:true, grid:{color:'#eef2f7'} },
                y:{ grid:{display:false}, ticks:{font:{size:10}} } } }
  });

  // Chart evaluadores
  const mE = new Map();
  datos.forEach(e => {
    const k = e.evaluador || 'Sin evaluador';
    mE.set(k, (mE.get(k)||0)+1);
  });
  const eOrd = [...mE.entries()].sort((a,b)=>b[1]-a[1]).slice(0,12);
  if (charts.chEvaluadores) charts.chEvaluadores.destroy();
  charts.chEvaluadores = new Chart(el('chEvaluadores').getContext('2d'), {
    type:'bar',
    data:{ labels: eOrd.map(x=>x[0]),
      datasets:[{ data: eOrd.map(x=>x[1]), backgroundColor:'#7c3aed', borderRadius:5 }] },
    options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ x:{ beginAtZero:true, grid:{color:'#eef2f7'} },
                y:{ grid:{display:false}, ticks:{font:{size:10}} } } }
  });

  // Tabla
  el('tablaCount').textContent = `${datos.length} inconsistencias mostradas`;
  const tbody = el('tbody');
  if (!datos.length){
    tbody.innerHTML = '<tr><td colspan="9" class="vacio">✅ Sin inconsistencias con los filtros aplicados</td></tr>';
    return;
  }
  const orden = {Alta:0, Media:1, Baja:2};
  const ordenados = [...datos].sort((a,b) => {
    const s = orden[a.sev] - orden[b.sev];
    if (s !== 0) return s;
