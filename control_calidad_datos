      <td>${e.comuna ? esc(e.comuna) : '<span style="color:#dc2626">(vacía)</span>'}</td>
      <td class="detalle">${esc(e.detalle)}</td>
    </tr>`;
  }).join('');
}

/* ============================================================
   VISTA POR EVALUADOR
   ============================================================ */
function renderEvaluador(){
  const datos = filtrarVistaEvaluador();

  const grupos = new Map();
  datos.forEach(e => {
    const k = e.evaluador || '(Sin evaluador)';
    if (!grupos.has(k)) grupos.set(k, {nombre: k, items: [], alta:0, media:0, baja:0, hojas: new Set(), filas: new Set(), formuladores: new Set()});
    const g = grupos.get(k);
    g.items.push(e);
    g[e.sev.toLowerCase()]++;
    g.hojas.add(e.__hoja);
    g.filas.add(e.__hoja+'|'+e.codigo);
    if (e.formulador) g.formuladores.add(e.formulador);
  });

  const total = datos.length;
  const numEvals = grupos.size;
  const alta = datos.filter(e=>e.sev==='Alta').length;
  const media = datos.filter(e=>e.sev==='Media').length;
  const baja = datos.filter(e=>e.sev==='Baja').length;
  const peor = [...grupos.values()].sort((a,b)=>b.alta-a.alta || b.items.length-a.items.length)[0];

  el('kpis2').innerHTML = `
    <div class="kpi"><div class="v">${numEvals}</div><div class="l">Evaluadores</div></div>
    <div class="kpi alta"><div class="v">${alta}</div><div class="l">Errores alta</div></div>
    <div class="kpi media"><div class="v">${media}</div><div class="l">Errores media</div></div>
    <div class="kpi baja"><div class="v">${baja}</div><div class="l">Errores baja</div></div>
    <div class="kpi ok"><div class="v">${total}</div><div class="l">Total inconsistencias</div></div>
    <div class="kpi" title="${peor ? esc(peor.nombre) : ''}">
      <div class="v" style="font-size:1rem;line-height:1.2;word-break:break-word">${peor ? esc(peor.nombre) : '—'}</div>
      <div class="l">Evaluador con más errores</div>
