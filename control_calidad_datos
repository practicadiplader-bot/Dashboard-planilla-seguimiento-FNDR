    num_doc_at: norm(pick(obj, 'num_doc_at')),
    fecha_at_str: norm(pick(obj, 'fecha_at')),
    fecha_at: parseFechaFlex(pick(obj, 'fecha_at')),
    resolucion_at: norm(pick(obj, 'resolucion_at','resolución_at')),
    fecha_ult_mov_str: norm(pick(obj, 'fecha_ultimo_movimiento')),
    fecha_ult_mov: parseFechaFlex(pick(obj, 'fecha_ultimo_movimiento')),
    tipo_doc_ingreso_mideso: norm(pick(obj, 'tipo_doc_ingreso_mideso')),
    num_doc_ingreso_mideso: norm(pick(obj, 'num_doc_ingreso_mideso')),
    fecha_ingreso_mideso_str: norm(pick(obj, 'fecha_ingreso_mideso')),
    fecha_ingreso_mideso: parseFechaFlex(pick(obj, 'fecha_ingreso_mideso')),
    n_oficio: norm(pick(obj, 'n_oficio')),
    fecha_oficio_str: norm(pick(obj, 'fecha_oficio')),
    fecha_oficio: parseFechaFlex(pick(obj, 'fecha_oficio')),
    fecha_ingreso_op_str: norm(pick(obj, 'fecha_ingreso_op_1')),
    fecha_ingreso_op: parseFechaFlex(pick(obj, 'fecha_ingreso_op_1'))
  };
  if (hoja !== 'admisibilidad_mideso') f.iteraciones = extraerIteraciones(obj);
  else f.bloquesAdm = extraerBloquesAdm(obj);
  return f;
}

/* ============================================================
   VALIDACIÓN
   ============================================================ */
function validarFilas(filas){
  const errores = [];
  const bipCountPorHoja = new Map();

  filas.forEach(f => {
    if (!f.codigo) return;
    const k = f.__hoja + '|' + f.codigo;
    bipCountPorHoja.set(k, (bipCountPorHoja.get(k)||0)+1);
  });

  filas.forEach(f => {
    const push = (regla, sev, detalle) => errores.push({...f, regla, sev, detalle});

    // BIP
    if (!f.codigoRaw) push('BIP vacío', 'Alta', 'No tiene Código BIP');
    else if (f.codigoRaw.toUpperCase() === 'S/C') push('BIP "S/C"', 'Alta', 'Usa "S/C" en lugar de un código BIP real');
    else if (/\.\d/.test(f.codigoRaw)) push('BIP con formato incorrecto', 'Baja', `"${f.codigoRaw}" (debe ser entero sin ".0")`);
    else if (!/^\d+$/.test(f.codigo)) push('BIP no numérico', 'Alta', `"${f.codigoRaw}" no es un código numérico válido`);

    if (f.codigo){
      const k = f.__hoja + '|' + f.codigo;
      const n = bipCountPorHoja.get(k)||0;
      if (n > 1) push('BIP duplicado en la hoja', 'Alta', `Aparece ${n} veces en "${f.__hoja}"`);
    }

    if (!f.nombre) push('Nombre vacío', 'Alta', 'Sin nombre de iniciativa');
    else if (/<br\s*\/?>|&lt;br/i.test(f.nombre)) push('Nombre con HTML residual', 'Baja', 'Contiene "<br>" u otra etiqueta HTML');

    if (!f.comuna){
      if (f.formulador.startsWith('Municipalidad')) push('Comuna vacía', 'Alta', `Municipalidad sin comuna`);
      else if (f.formulador) push('Comuna vacía', 'Media', `Formulador "${f.formulador}" sin comuna`);
    } else if (!COMUNAS_VALIDAS.has(f.comuna) &&
               !/^(MALLECO|CAUTÍN|CAUTIN|REGION|REGIÓN|REGIONAL|SSAS|SSAN|NACIONAL|CONAF|MINVU)$/i.test(f.comuna)){
      push('Comuna no reconocida', 'Media', `"${f.comuna}" no está entre las 32 comunas`);
    } else if (f.formulador.startsWith('Municipalidad')){
      const esperada = COMUNA_POR_MUNI[f.formulador];
      if (esperada && normKey(esperada) !== normKey(f.comuna))
        push('Comuna no coincide con formulador', 'Media',
             `Formulador "${f.formulador}" ≠ comuna "${f.comuna}" (esperado: ${esperada})`);
    }

    if (!f.formulador) push('Formulador vacío', 'Alta', 'Sin entidad formuladora');
    if (!f.evaluador && f.estado && !/recepcion|ingresado|no admisible/i.test(f.estado))
      push('Evaluador vacío', 'Baja', `Estado "${f.estado}" sin evaluador asignado`);
    if (!f.estado) push('Estado vacío', 'Alta', 'Sin estado asignado');

    if (f.monto === null || f.monto === 0) push('Monto vacío o cero', 'Media', `Valor: "${f.montoRaw || '(vacío)'}"`);
    else if (f.monto < 0) push('Monto negativo', 'Alta', `Monto: ${f.monto}`);
    else if (f.monto > 100000000) push('Monto sospechoso', 'Media', `${f.monto.toLocaleString('es-CL')} m$ — ¿está en pesos en lugar de M$?`);
    if (/\$/.test(f.montoRaw)) push('Monto con signo $', 'Baja', `"${f.montoRaw}" contiene "$" (no corresponde)`);

    if (f.__hoja === 'cartera_29'){
      if (f.estado.toLowerCase() === 'otros' && /^0[.,]02$/.test(f.tipologia))
        push('Valor mal ubicado (0,02)', 'Media', `Estado "Otros" con tipología "${f.tipologia}"`);
      if (f.resolucion_at && /^\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}$/.test(f.resolucion_at))
        push('Resolución_AT contiene fecha', 'Media', `"${f.resolucion_at}" debe ser N° de resolución`);
    }

    if (f.__hoja === 'admisibilidad_mideso'){
      if (/campo equivocado|campo incorrecto/i.test(f.observaciones))
        push('Nota: dato mal ubicado', 'Baja', f.observaciones.slice(0,120));
      if (f.num_doc_ingreso_mideso && /^\d{1,3}(\.\d{3})+$/.test(f.num_doc_ingreso_mideso))
        push('N° oficio con separador de miles', 'Baja', `"${f.num_doc_ingreso_mideso}" debe ser entero`);
      if (!f.fecha_ult_mov_str && f.estado && !/no admisible/i.test(f.estado))
        push('Fecha último mov. vacía', 'Baja', `Estado "${f.estado}" sin Fecha Último Movimiento`);
    }

    if (f.iteraciones){
      const conDatos = f.iteraciones.filter(it =>
        it.envio.tipo||it.envio.num||it.envio.fechaStr ||
        it.resp.tipo||it.resp.num||it.resp.fechaStr);

      conDatos.forEach(it => {
        const e = it.envio, r = it.resp;
        if ((e.tipo||e.num||e.fechaStr) && !(r.tipo||r.num||r.fechaStr)){
          if (!(f.estado && /espera respuesta/i.test(f.estado)))
            push('Envío sin respuesta', 'Media', `It.${it.i}: envío ${e.num||e.tipo||''} sin respuesta`);
        }
        if ((r.tipo||r.num||r.fechaStr) && !(e.tipo||e.num||e.fechaStr))
          push('Respuesta sin envío', 'Alta', `It.${it.i}: respuesta ${r.num||r.tipo||''} sin envío previo`);
        if (e.tipo && !e.num) push('Envío sin N° oficio', 'Baja', `It.${it.i}: tipo "${e.tipo}" sin número`);
        if (r.tipo && !r.num) push('Respuesta sin N° oficio', 'Baja', `It.${it.i}: tipo "${r.tipo}" sin número`);
        if (e.num && !e.fechaStr) push('Envío sin fecha', 'Media', `It.${it.i}: N° ${e.num} sin fecha`);
        if (r.num && !r.fechaStr) push('Respuesta sin fecha', 'Media', `It.${it.i}: N° ${r.num} sin fecha`);
        if (e.fechaStr && !e.num) push('Envío con fecha sin N°', 'Media', `It.${it.i}: fecha ${e.fechaStr} sin N°`);
        if (r.fechaStr && !r.num) push('Respuesta con fecha sin N°', 'Media', `It.${it.i}: fecha ${r.fechaStr} sin N°`);
        if (e.tipo && !TIPOS_DOC_VALIDOS.has(e.tipo)) push('Tipo doc no estándar', 'Baja', `Envío it.${it.i}: "${e.tipo}"`);
        if (r.tipo && !TIPOS_DOC_VALIDOS.has(r.tipo)) push('Tipo doc no estándar', 'Baja', `Respuesta it.${it.i}: "${r.tipo}"`);
        if (e.fechaStr && !e.fecha) push('Fecha ilegible (envío)', 'Media', `It.${it.i}: "${e.fechaStr}"`);
        if (r.fechaStr && !r.fecha) push('Fecha ilegible (respuesta)', 'Media', `It.${it.i}: "${r.fechaStr}"`);
        if (esFechaSentinel(e.fecha)) push('Fecha placeholder en envío', 'Baja', `It.${it.i}: ${fmtFecha(e.fecha)}`);
        if (esFechaSentinel(r.fecha)) push('Fecha placeholder en respuesta', 'Baja', `It.${it.i}: ${fmtFecha(r.fecha)}`);
        if (esFechaFutura(e.fecha)) push('Fecha futura (envío)', 'Alta', `It.${it.i}: ${fmtFecha(e.fecha)}`);
        if (esFechaFutura(r.fecha)) push('Fecha futura (respuesta)', 'Alta', `It.${it.i}: ${fmtFecha(r.fecha)}`);
      });

      const activas = conDatos.map(it => it.i).sort();
      if (activas.length >= 2){
        for (let i = activas[0]; i < activas[activas.length-1]; i++){
          if (!activas.includes(i)) push('Iteración salteada', 'Media', `Falta iteración ${i}`);
        }
      }
    }

    if (f.tipo_doc_at || f.num_doc_at || f.fecha_at_str){
      if (f.tipo_doc_at && !f.num_doc_at) push('AT sin N°', 'Baja', `Tipo "${f.tipo_doc_at}" sin N°`);
      if (f.num_doc_at && !f.fecha_at_str) push('AT sin fecha', 'Media', `N° ${f.num_doc_at} sin fecha`);
      if (f.fecha_at_str && !f.num_doc_at) push('AT con fecha sin N°', 'Media', `Fecha ${f.fecha_at_str} sin N°`);
      if (f.fecha_at_str && !f.fecha_at) push('Fecha AT ilegible', 'Media', `"${f.fecha_at_str}"`);
      if (esFechaFutura(f.fecha_at)) push('Fecha AT futura', 'Alta', fmtFecha(f.fecha_at));
      if (esFechaSentinel(f.fecha_at)) push('Fecha AT placeholder', 'Baja', fmtFecha(f.fecha_at));
    }
  });

  return errores;
}

/* ============================================================
   ESTADO
   ============================================================ */
let ERRORES = [];
let TODAS_LAS_FILAS = [];
let hojaActiva = 'TODAS';
let vistaActual = 'detalle';
let charts = {};

/* ============================================================
   CARGA
   ============================================================ */
async function cargarTodo(){
  el('msgBox').innerHTML = '<div class="msg info">⏳ Cargando datos desde las 4 hojas…</div>';
  const todasFilas = [];
  const resumen = [];

  for (const h of HOJAS){
    try{
      const tabla = await cargarHoja(h);
      const filas = tablaAFilas(tabla, h).map(r => normalizarFila(r, h));
      const utiles = filas.filter(f => f.codigo || f.nombre);
      todasFilas.push(...utiles);
      resumen.push(`✅ <b>${h}</b>: ${utiles.length} filas`);
    }catch(e){
      resumen.push(`❌ <b>${h}</b>: ${e.message}`);
    }
  }

  TODAS_LAS_FILAS = todasFilas;
  ERRORES = validarFilas(todasFilas);

  const numEvals = new Set(ERRORES.map(e => e.evaluador||'(sin evaluador)')).size;
  el('msgBox').innerHTML = `<div class="msg ok"><b>Resumen de carga:</b><br>${resumen.join('<br>')}<br><br>
    <b>Total:</b> ${todasFilas.length} filas · <b>${ERRORES.length} inconsistencias</b> · 
    <b>${numEvals} evaluadores afectados</b></div>`;

  // Poblar selects
  const eSet = [...new Set(ERRORES.map(e => e.evaluador).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));
  const eOpts = '<option value="">Todos</option>' + eSet.map(v=>`<option>${esc(v)}</option>`).join('');
  el('fEvaluador').innerHTML = eOpts;

  const fSet = [...new Set(ERRORES.map(e => e.formulador).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));
  const fOpts = '<option value="">Todos</option>' + fSet.map(v=>`<option>${esc(v)}</option>`).join('');
  el('fFormulador').innerHTML = fOpts;
  el('fFormulador2').innerHTML = fOpts;

  const rSet = [...new Set(ERRORES.map(e => e.regla))].sort((a,b)=>a.localeCompare(b,'es'));
  const rOpts = '<option value="">Todos</option>' + rSet.map(v=>`<option>${esc(v)}</option>`).join('');
  el('fRegla').innerHTML = rOpts;
  el('fRegla2').innerHTML = rOpts;

  render();
}

/* ============================================================
   FILTROS
   ============================================================ */
function filtrarBase(){
  const fE = el('fEvaluador').value;
  const fF = el('fFormulador').value;
  const fS = el('fSeveridad').value;
  const fR = el('fRegla').value;
  const fT = el('fTexto').value.trim().toLowerCase();

  return ERRORES.filter(e => {
    if (hojaActiva !== 'TODAS' && e.__hoja !== hojaActiva) return false;
    if (fE && e.evaluador !== fE) return false;
    if (fF && e.formulador !== fF) return false;
    if (fS && e.sev !== fS) return false;
    if (fR && e.regla !== fR) return false;
    if (fT && !e.codigo.toLowerCase().includes(fT) && !e.nombre.toLowerCase().includes(fT)) return false;
    return true;
  });
}

function filtrarVistaEvaluador(){
  const fS = el('fSeveridad2').value;
  const fR = el('fRegla2').value;
  const fF = el('fFormulador2').value;
  const fB = el('buscarEvaluador').value.trim().toLowerCase();

  return ERRORES.filter(e => {
    if (hojaActiva !== 'TODAS' && e.__hoja !== hojaActiva) return false;
    if (fS && e.sev !== fS) return false;
    if (fR && e.regla !== fR) return false;
    if (fF && e.formulador !== fF) return false;
    if (fB && !(e.evaluador||'').toLowerCase().includes(fB)) return false;
    return true;
  });
}

/* ============================================================
   RENDER PRINCIPAL
   ============================================================ */
function render(){
  if (vistaActual === 'detalle') renderDetalle();
  else renderEvaluador();
}

/* ============================================================
   VISTA DETALLE
   ============================================================ */
